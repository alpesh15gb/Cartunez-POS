{
  "name": "@motorline/desktop",
  "version": "1.1.0",
  "private": true,
  "description": "Motorline automotive POS desktop client",
  "author": "Motorline",
  "main": "main.cjs",
  "scripts": {
    "dev": "install-electron && electron .",
    "package": "electron-builder --win nsis --x64",
    "package:dir": "electron-builder --win --dir --x64"
  },
  "dependencies": {
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.motorline.pos",
    "productName": "Motorline POS",
    "directories": {
      "output": "../../release/windows"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/out",
        "to": "web"
      }
    ],
    "win": {
      "target": "nsis",
      "signExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "artifactName": "Motorline-POS-Setup-${version}.${ext}"
  }
}
