{
  "name": "motorline-production",
  "private": true,
  "version": "1.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @motorline/api",
    "build:api": "npm run build -w @motorline/api",
    "test:api": "npm run test -w @motorline/api",
    "db:migrate": "npm run migrate -w @motorline/api",
    "db:seed": "npm run seed -w @motorline/api"
  },
  "devDependencies": {
    "playwright-core": "^1.65.1"
  }
}
