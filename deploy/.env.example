POSTGRES_DB=motorline
POSTGRES_USER=motorline
# Use URL-safe random secrets (hex works). Do not commit .env.
POSTGRES_PASSWORD=replace-with-64-random-hex-characters
JWT_SECRET=replace-with-an-independent-64-random-hex-secret
CORS_ORIGINS=https://pos.shop.local,motorline://app,https://localhost
TRUST_PROXY_HOPS=1
SEED_DEMO=false
BOOTSTRAP_OWNER_EMAIL=owner@shop.local
BOOTSTRAP_OWNER_NAME=Owner
BOOTSTRAP_OWNER_PASSWORD=replace-with-a-strong-password-of-at-least-16-characters
BOOTSTRAP_ORG_ID=shop
BOOTSTRAP_ORG_NAME=Motorline Shop
BOOTSTRAP_BRANCH_ID=main
BOOTSTRAP_BRANCH_NAME=Main branch
BOOTSTRAP_CURRENCY=INR
