    </div>
    <?php if ($vehicles): ?>
    <script type="application/json" id="cz-vehicles"><?= /* @noEscape */ $block->getVehiclesJson() ?></script>
    <script>
    (function () {
        var root = document.getElementById('cz-finder');
        var data = JSON.parse(document.getElementById('cz-vehicles').textContent || '{}');
        var make = document.getElementById('cz-make');
        var model = document.getElementById('cz-model');
        var year = document.getElementById('cz-year');
        var form = make.form;
        var saved = root.querySelector('.cz-finder-saved');
        var savedText = saved.querySelector('.cz-finder-saved-text');
        var shop = saved.querySelector('.cz-finder-shop');
        var labels = { make: make.options[0].textContent, model: model.options[0].textContent, year: year.options[0].textContent };
        function fill(select, values, placeholder, value) {
            select.innerHTML = '';
            var first = document.createElement('option');
            first.value = '';
            first.textContent = placeholder;
            select.appendChild(first);
            values.forEach(function (v) {
                var o = document.createElement('option');
                o.value = o.textContent = v;
                select.appendChild(o);
            });
            select.disabled = values.length === 0;
            if (value && values.indexOf(value) >= 0) select.value = value;
        }
        // Same search word the POS writes: lowercase letters and digits only.
        function word(v) { return String(v).toLowerCase().replace(/[^a-z0-9]+/g, ''); }
        function models(m) { return m && data[m] ? Object.keys(data[m]) : []; }
        function years(m, n) { return m && n && data[m] && data[m][n] ? data[m][n].map(String) : []; }
        function load() {
            try {
                var v = JSON.parse(localStorage.getItem('cz-vehicle') || 'null');
                if (v && years(v.make, v.model).indexOf(String(v.year)) >= 0) return v;
            } catch (x) {}
            return null;
        }
        function searchUrl(v) {
            return form.action + (form.action.indexOf('?') < 0 ? '?' : '&') + 'q=' + encodeURIComponent(word(v.make) + word(v.model) + v.year);
        }
        function show(v) {
            var q = new URLSearchParams(location.search).get('q') || '';
            var here = v && q === word(v.make) + word(v.model) + v.year;
            if (!v) { saved.hidden = true; form.hidden = false; return; }
            var name = v.make + ' ' + v.model + ' ' + v.year;
            savedText.textContent = (here ? 'Showing parts for ' : 'Your car: ') + name;
            shop.hidden = !!here;
            shop.href = searchUrl(v);
            saved.hidden = false;
            form.hidden = true;
        }
        var vehicle = load();
        fill(make, Object.keys(data), labels.make, vehicle && vehicle.make);
        fill(model, models(make.value), labels.model, vehicle && vehicle.model);
        fill(year, years(make.value, model.value), labels.year, vehicle && String(vehicle.year));
        show(vehicle);
        make.addEventListener('change', function () {
            fill(model, models(make.value), labels.model);
            fill(year, [], labels.year);
        });
        model.addEventListener('change', function () {
            fill(year, years(make.value, model.value), labels.year);
        });
        function open() {
            form.hidden = false;
            saved.hidden = true;
            make.focus();
        }
        saved.querySelector('.cz-finder-change').addEventListener('click', open);
        // "Shop by car" in the menu opens the finder (scripts.phtml).
        root.addEventListener('cz-finder-open', function () { if (!load()) make.focus(); });
        form.addEventListener('submit', function (e) {
            if (!make.value || !model.value || !year.value) { e.preventDefault(); return; }
            form.q.value = word(make.value) + word(model.value) + year.value;
            try { localStorage.setItem('cz-vehicle', JSON.stringify({ make: make.value, model: model.value, year: year.value })); } catch (x) {}
        });
    })();
    </script>
    <?php endif; ?>
</section>
