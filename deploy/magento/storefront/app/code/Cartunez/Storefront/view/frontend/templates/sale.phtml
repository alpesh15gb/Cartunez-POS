<?php
/** @var \Cartunez\Storefront\Block\SaleProducts $block */
/** @var \Magento\Framework\Escaper $escaper */
if (!$block->hasProducts()) {
    return;
}
$grid = $block->getGridHtml();
if (trim($grid) === '') {
    return;
}
?>
<section class="cz-sale" aria-labelledby="cz-sale-title">
    <div class="cz-section-head cz-section-head--split">
        <div>
            <span class="cz-kicker cz-kicker--red"><?= $escaper->escapeHtml(__('On sale')) ?></span>
            <h2 id="cz-sale-title"><?= $escaper->escapeHtml(__('Deals on upgrades')) ?></h2>
        </div>
        <a class="cz-row-all cz-sale-all" href="<?= $escaper->escapeUrl($block->getViewAllUrl()) ?>">
            <?= $escaper->escapeHtml(__('View all (%1)', $block->getProductCount())) ?><?= /* @noEscape */ \Cartunez\Storefront\Model\Icons::svg('arrow', 16) ?>
        </a>
    </div>
    <div class="cz-sale-grid"><?= /* @noEscape */ $grid ?></div>
</section>
