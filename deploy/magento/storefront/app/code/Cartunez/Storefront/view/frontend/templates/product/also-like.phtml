<?php
/** @var \Cartunez\Storefront\Block\AlsoLike $block */
/** @var \Magento\Framework\Escaper $escaper */
$items = $block->getItems();
if (!$items) {
    return;
}
?>
<section class="cz-also block" aria-labelledby="cz-also-title">
    <div class="cz-section-head cz-section-head--split">
        <div>
            <span class="cz-kicker"><?= $escaper->escapeHtml(__('Pairs well with')) ?></span>
            <h2 id="cz-also-title"><?= $escaper->escapeHtml(__('You may also like')) ?></h2>
        </div>
    </div>
    <div class="products wrapper grid products-grid cz-also-list">
        <ol class="products list items product-items">
            <?php foreach ($items as $item): ?>
                <?= /* @noEscape */ $block->renderCard($item) ?>
            <?php endforeach; ?>
        </ol>
    </div>
</section>
