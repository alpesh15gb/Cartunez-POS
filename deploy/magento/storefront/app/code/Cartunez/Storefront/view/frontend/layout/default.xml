<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <!-- Offer bar above the header; edit in Content > Blocks > cartunez-announcement. -->
        <referenceContainer name="page.wrapper">
            <block class="Magento\Cms\Block\Block" name="cartunez.announcement" before="-">
                <arguments>
                    <argument name="block_id" xsi:type="string">cartunez-announcement</argument>
                </arguments>
            </block>
        </referenceContainer>
        <referenceContainer name="before.body.end">
            <block class="Magento\Framework\View\Element\Template" name="cartunez.scripts" template="Cartunez_Storefront::scripts.phtml"/>
        </referenceContainer>
    </body>
</page>
